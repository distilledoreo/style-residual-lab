# Local target corpora. Never commit corpus text, audio, manifests, or other corpus files.
target-corpus/*
!target-corpus/README.md

private-corpus/*
!private-corpus/README.md

# Pipeline raw inputs imported from local corpora.
data/raw/*
!data/raw/README.md

# Experiment trees copy raw corpus text and embed text in derived outputs.
data/experiments/**/raw/
data/experiments/**/processed/
data/experiments/**/features/
data/experiments/**/embeddings/
data/experiments/**/models/
data/experiments/**/reports/

# Isolated private experiment outputs can contain copied raw corpus text.
data/private/
data/experiments/private-*/
